{
  "name": "autoinfluencer-desktop",
  "productName": "autoinfluencer",
  "version": "0.3.1",
  "private": true,
  "description": "autoinfluencer desktop: the hosted app, the CLI and a local MCP server in one install.",
  "author": {
    "name": "Profullstack, Inc.",
    "email": "riotcoder@profullstack.com"
  },
  "homepage": "https://influencer.marketing.pit.world",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@profullstack/autoinfluencer": "^0.3.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.profullstack.autoinfluencer",
    "productName": "autoinfluencer",
    "files": [
      "main.js",
      "icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@profullstack/autoinfluencer/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "icon.png",
      "maintainer": "Profullstack <riotcoder@profullstack.com>"
    },
    "deb": {
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "artifactName": "autoinfluencer-${version}-${os}-${arch}.${ext}"
  }
}
