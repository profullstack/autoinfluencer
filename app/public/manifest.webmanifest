{
  "name": "autoinfluencer",
  "short_name": "autoinfluencer",
  "description": "Your AI social media manager: posts in your voice for every network.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#111111",
  "theme_color": "#111111",
  "categories": ["productivity", "social", "business"],
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Write posts", "url": "/#write" },
    { "name": "Sites", "url": "/#sites" },
    { "name": "Inbox", "url": "/#inbox" },
    { "name": "Scheduled posts", "url": "/#social" },
    { "name": "Desktops", "url": "/#desktops" }
  ]
}
